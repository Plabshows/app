{
    "buildCommand": "npx expo export -p web",
    "outputDirectory": "dist",
    "framework": null,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/ai-responder",
            "schedule": "* * * * *"
        }
    ]
}